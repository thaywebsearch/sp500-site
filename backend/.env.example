# Porta da API Express (Railway injeta automaticamente; local usa 5001)
PORT=5001

# Origens permitidas pelo CORS, separadas por vírgula. Se vazio/ausente, o CORS
# fica permissivo (qualquer origem) — útil apenas em desenvolvimento.
# Ex.: CORS_ORIGINS=https://usuario.github.io,http://localhost:5173
# CORS_ORIGINS=
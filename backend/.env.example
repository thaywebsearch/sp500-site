# Porta da API Express (Railway injeta automaticamente; local usa 5001)
PORT=5001

# Origens permitidas pelo CORS, separadas por vírgula. O CORS é RESTRITIVO por
# omissão: sem esta variável, nenhuma origem externa é aceite (apenas pedidos
# sem Origin: curl, health checks e same-origin). Em desenvolvimento local,
# define por exemplo:
# Ex.: CORS_ORIGINS=https://usuario.github.io,http://localhost:5173
# CORS_ORIGINS=
